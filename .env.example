# Copia este archivo a .env (no lo subas a GitHub) o crea estos valores como "Secrets" del repositorio.

# Claude (lee los portales web y valora los pisos) — https://console.anthropic.com
ANTHROPIC_API_KEY=

# Idealista, API oficial (opcional) — solicitar en https://developers.idealista.com/access-request
IDEALISTA_API_KEY=
IDEALISTA_API_SECRET=

# Email (Gmail: activa la verificación en 2 pasos y crea una "contraseña de aplicación")
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=tu_correo@gmail.com
SMTP_PASSWORD=
EMAIL_TO=tu_correo@gmail.com

# WhatsApp: tu número con prefijo, p. ej. +34600111222
WHATSAPP_TO=
# Opción A, CallMeBot (gratis): https://www.callmebot.com/blog/free-api-whatsapp-messages/
CALLMEBOT_APIKEY=
# Opción B, Twilio (cambia whatsapp_proveedor a "twilio" en config.yaml)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
